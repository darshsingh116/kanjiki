# Only the Flutter web build needs to run inside Docker — keep the build
# context small and reproducible.
.git/
.github/
.dart_tool/
.vscode/
.idea/
build/
docker/
*.md

# Native platforms not needed for `flutter build web` or `flutter build apk`
ios/
linux/
macos/
windows/

# Machine-local SDK paths; the Flutter Gradle plugin regenerates this
# inside the container.
android/local.properties

.env
.env.*
!.env.example
