# PRODUCTION config — your real Supabase project. Used by scripts/build_web_prod.sh
# and scripts/build_app_prod.sh (and docker-compose.prod.yml) to bake prod
# credentials into release builds via --dart-define. Never commit the real
# .env.production this gets copied to.
#
#   cp env.production.example .env.production
#   # fill in your real project's values below
#   ./scripts/build_web_prod.sh
#   ./scripts/build_app_prod.sh

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Web only — set to your real domain to get automatic HTTPS from Caddy.
# Leave blank to serve plain HTTP on :80 (e.g. behind your own reverse proxy).
CADDY_DOMAIN=
