# Config for `docker compose up` (the LOCAL Supabase stack + app container).
# Copy to `.env.docker` — that file is gitignored, this example is not.
#
#   cp docker.env.example .env.docker
#
# ⚠️  DEV ONLY. The JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY below are the
# public demo values from Supabase's own self-hosting quickstart — anyone
# can forge tokens with them. Never reuse them for a real deployment; for
# production point the `app` service at your real hosted/self-hosted
# Supabase project instead (see OPENSOURCE_MIGRATION_GUIDE.md).

############
# Postgres
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_PORT=54322

############
# Auth (GoTrue) / PostgREST / Realtime — must all agree on this secret
############
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

############
# Realtime
############
REALTIME_SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

############
# Kong (API gateway) — this is the local SUPABASE_URL the app talks to
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# Studio (Supabase dashboard, http://localhost:3001)
############
STUDIO_PORT=3001
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

############
# App container (Flutter Web build, served by Caddy)
############
APP_PORT=8080
# For local dev these point at Kong above; leave as-is unless you're testing
# against a real project.
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
